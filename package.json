{
    "name":  "football-editor",
    "version":  "1.0.9",
    "description":  "Video player for football analysis",
    "main":  "main.js",
    "scripts":  {
                    "start":  "electron .",
                    "dist":  "electron-builder"
                },
    "keywords":  [

                 ],
    "author":  "joaopakina14",
    "license":  "MIT",
    "devDependencies":  {
                            "electron":  "^31.0.0",
                            "electron-builder":  "^24.13.3",
                            "electron-packager":  "^17.1.2"
                        },
    "dependencies":  {
                         "ffmpeg-static":  "^5.3.0",
                         "fluent-ffmpeg":  "^2.1.3"
                     },
    "build":  {
                  "appId":  "com.fieldvision.app",
                  "productName":  "FieldVision",
                  "win":  {
                              "target":  "nsis",
                              "icon":  "assets/icon.ico"
                          },
                  "nsis":  {
                               "oneClick":  false,
                               "allowToChangeInstallationDirectory":  true,
                               "createDesktopShortcut":  "always",
                               "installerIcon":  "assets/icon.ico",
                               "uninstallerIcon":  "assets/icon.ico",
                               "artifactName":  "FieldVision-Setup-${version}.${ext}"
                           },
                  "asar":  true,
                  "asarUnpack":  [
                                     "tracker.py"
                                 ],
                  "files":  [
                                "**/*",
                                "!FieldVision-website/**/*",
                                "!docs/**/*"
                            ]
              }
}
